# ============================================================
# Multimodal RAG 智能问答系统 — 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ============================================================
# LLM 配置 (OpenAI 兼容)
# ============================================================
LLM_API_KEY=sk-your_llm_api_key_here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=Qwen3.5-2B
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# ============================================================
# Embedding 配置 (OpenAI 兼容)
# ============================================================
EMBEDDING_API_KEY=sk-your_embedding_api_key_here
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=jina-embeddings-v5-omni-nano-retrieval-AX650-P128-CTX2047
EMBEDDING_DIMENSIONS=1024

# ============================================================
# 向量库配置
# ============================================================
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=multimodal_rag

# ============================================================
# 预处理参数
# ============================================================

# --- 文本分块 ---
TEXT_CHUNK_SIZE=512               # 每块最大 token 数
TEXT_CHUNK_OVERLAP=64             # 块间重叠 token 数

# --- 图片处理 ---
IMAGE_TARGET_SIZE=256             # 处理后图片边长 (px), 居中裁剪为正方形
IMAGE_QUALITY=85                  # JPEG 编码质量 (1-100)

# --- 音频切片 ---
AUDIO_MAX_DURATION_SEC=25.0       # 单个音频片段最大时长 (秒)
AUDIO_OVERLAP_SEC=1.0             # 片段间重叠时长 (秒)

# --- 视频处理 (单视频单向量) ---
VIDEO_TARGET_SIZE=256             # 处理后视频分辨率短边 (px), 居中填充正方形
VIDEO_MAX_FRAMES=32               # 处理后视频最大帧数
VIDEO_QA_FRAMES=4                 # Q&A 时从视频提取的帧数 (送入多模态 LLM)
